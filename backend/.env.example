# Copia este fichero como .env (el instalador lo hace por ti) y ajústalo a tu equipo.

# Dirección del backend. Déjalo en 127.0.0.1 para que nadie de la red pueda usarlo.
HOST=127.0.0.1
PORT=8000

# Ollama. Solo se aceptan direcciones locales (localhost, 127.0.0.1, ::1).
OLLAMA_URL=http://127.0.0.1:11434

# Modelos de Ollama. El instalador elige CHAT_MODEL según la GPU:
#   GPU NVIDIA con 12 GB o más:  qwen2.5:14b
#   resto (GPU pequeña o CPU):   qwen2.5:7b
# Si cambias EMBED_MODEL tendrás que reindexar la base de conocimiento.
CHAT_MODEL=qwen2.5:7b
VISION_MODEL=qwen2.5vl:7b
EMBED_MODEL=bge-m3

# Capturas de pantalla: true = modelo de visión + OCR; false = solo OCR (mucho más rápido en CPU).
VISION_ACTIVA=true

# Dominios de tu organización, separados por comas (sus indicadores se marcan como propios).
# DOMINIOS_PROPIOS=empresa.es,empresa.com

# Carpeta de datos (fichas, documentos y vectores). Relativa a la raíz del repositorio.
DATA_DIR=data

# Ruta a tesseract.exe si no está en el PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
